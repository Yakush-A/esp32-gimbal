#page(
  numbering: none,
  paper: "a4",
  margin: (
    top: 2cm,
    bottom: 2cm,
    right: 1.5cm,
    left: 3cm,
  ),
)[

  #show: set text(
    font: "Times New Roman",
    size: 14pt,
    top-edge: 1em,
    bottom-edge: 0em,
    hyphenate: true,
    lang: "ru",
  )
  #show: set par(
    justify: true,
    leading: 4pt, 
    spacing: 4pt,

    first-line-indent: 0em,
  )

  
  #align(center)[
    Министерство образования Республики Беларусь \
    Учреждение образования \
    «БЕЛОРУССКИЙ ГОСУДАРСТВЕННЫЙ УНИВЕРСИТЕТ \
    ИНФОРМАТИКИ И РАДИОЭЛЕКТРОНИКИ»
  ]
  #v(1.0em)
  Факультет компьютерных систем и сетей
  #v(1.0em)
  Кафедра электронных вычислительных машин
  #v(1.0em)
  Дисциплина: Схемотехника
  #v(10.0em)

  #align(center)[
    ПОЯСНИТЕЛЬНАЯ ЗАПИСКА \
    к курсовому проекту \
    на тему
    \ \
    УСТРОЙСТВО УДАЛЕННОЙ СТАБИЛИЗАЦИИ КАМЕРЫ
    \ \
    БГУИР КП 6-05-0611-05 126 ПЗ
  ]
  #v(10.0em)


  #grid(
    columns: (3fr, 1fr),
    [
      Студент:
      #v(1.0em)
      Руководитель:
    ],
    [
      А.П. Якуш
      #v(1.0em)
      Д.Н. Одинец
    ]
  )

  #v(1.0fr)
  #align(center)[Минск 2026]
]
